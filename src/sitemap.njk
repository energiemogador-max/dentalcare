---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Eleventy from the `pages` collection. Do not hand-edit
     the built output. Every url element emits the full xhtml:link alternate
     cluster (one entry per language plus x-default) for its translationKey
     group, and this keeps working as pages are added in later phases. See
     .eleventy.js for the translationKey convention this depends on.
     Note for editors: XML comments may not contain two consecutive
     hyphen characters anywhere in this block. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- set groups = collections.pages | groupByTranslationKey(site.languages) %}
{%- for group in groups %}
{%- set defaultPage = group | findByLang(site.defaultLang) %}
{%- for p in group %}
    <url>
        <loc>https://{{ site.domain }}{{ p.url }}</loc>
        {%- for sibling in group %}
        <xhtml:link rel="alternate" hreflang="{{ sibling.data.lang }}" href="https://{{ site.domain }}{{ sibling.url }}"/>
        {%- endfor %}
        <xhtml:link rel="alternate" hreflang="x-default" href="https://{{ site.domain }}{{ defaultPage.url }}"/>
    </url>
{%- endfor %}
{%- endfor %}
</urlset>
